# ─── AU Reader Flutter App — Template ────────────────────────────────────────
# Salin file ini menjadi .env lalu sesuaikan nilainya.

# URL backend Go (port 8000 by default)
# - Emulator Android : http://10.0.2.2:8000/api/v1
# - Emulator iOS / Desktop : http://127.0.0.1:8000/api/v1
# - HP fisik via WiFi : http://<IP_LAN_PC>:8000/api/v1
API_BASE_URL=http://127.0.0.1:8000/api/v1

# Base URL untuk gambar / image proxy (tanpa /api/v1)
API_IMAGE_URL=http://127.0.0.1:8000
