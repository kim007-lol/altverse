# ─── App ───
APP_ENV=development
APP_PORT=8000
APP_URL=http://localhost:8000

# ─── Database (PostgreSQL) ───
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=au_reader
DB_SSLMODE=disable

# ─── Redis ───
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ─── JWT ───
JWT_SECRET=change-this-super-secret-key
JWT_ACCESS_EXP_MINUTES=15
JWT_REFRESH_EXP_DAYS=7

# ─── Cloudflare R2 (S3-compatible) ───
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=aureader
R2_PUBLIC_URL=
R2_ENDPOINT=

# ─── Midtrans Payment Gateway ───
MIDTRANS_MERCHANT_ID=
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false

# ─── Rate Limiting ───
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_PERIOD=M

# ─── CORS ───
ALLOWED_ORIGINS=*
