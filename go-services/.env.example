# ─── AU Reader Go Image Proxy ───
# Copy this to .env and fill in your R2 credentials

# Server port
PORT=9000

# Cloudflare R2 / S3 credentials
R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
R2_BUCKET=aureader
R2_ACCESS_KEY=your_access_key
R2_SECRET_KEY=your_secret_key
R2_REGION=auto

# LRU cache size in MB (default: 256)
CACHE_SIZE_MB=256

# CORS allowed origins (* = all, for production set to your domain)
ALLOWED_ORIGINS=*
